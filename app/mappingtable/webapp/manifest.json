{
  "_version": "1.59.0",
  "sap.app": {
    "id": "scrum5.mappingtable",
    "type": "application",
    "title": "Mapping Table",
    "description": "Maintain mapping_table entries",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/mapping/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.fe.templates": {} }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": { "operationMode": "Server", "autoExpandSelect": true, "earlyRequests": true }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        { "pattern": ":?query:", "name": "MappingTableList", "target": "MappingTableList" },
        { "pattern": "MappingTable({key}):?query:", "name": "MappingTableObjectPage", "target": "MappingTableObjectPage" }
      ],
      "targets": {
        "MappingTableList": {
          "type": "Component",
          "id": "MappingTableList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/MappingTable",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "MappingTable": { "detail": { "route": "MappingTableObjectPage" } }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": { "type": "ResponsiveTable", "selectionMode": "Multi" }
                }
              }
            }
          }
        },
        "MappingTableObjectPage": {
          "type": "Component",
          "id": "MappingTableObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": { "contextPath": "/MappingTable", "editableHeaderContent": false }
          }
        }
      }
    }
  }
}
